{
  "name": "phishing-check",
  "version": "1.0.0",
  "description": "Prüfung verdächtiger E-Mails und Webseiten: Absender, Zustellweg, Links, Inhalt und Anhänge nach nachvollziehbaren, begründeten Regeln. Mails bleiben offline; Webseiten werden nur auf Wunsch abgerufen.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "phishing-check": "./bin/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node build.mjs",
    "check": "node bin/cli.js",
    "server": "node bin/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/",
    "bin/",
    "dist/"
  ],
  "keywords": [
    "phishing",
    "email",
    "sicherheit",
    "deutsch",
    "offline"
  ],
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "playwright": "^1.56.1"
  }
}
